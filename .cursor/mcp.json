{
  "mcpServers": {
    "layout": {
      "command": "npx",
      "args": [
        "-y",
        "@layoutdesign/context",
        "serve"
      ]
    },
    "figma-console": {
      "command": "npx",
      "args": [
        "-y",
        "figma-console-mcp@latest"
      ],
      "envFile": "${workspaceFolder}/.cursor/mcp.local.env"
    }
  }
}
